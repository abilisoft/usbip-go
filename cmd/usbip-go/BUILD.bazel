        "style_switch_test.go",
        "table_devices_test.go",
        "table_test.go",
        "test_constants_test.go",
        "watch_test.go",
    ],
    data = glob([
        "*.go",
        "testdata/**",
    ]) + [
        ":usbip-go",
        "//:.goreleaser.yml",
    ],
    embed = [":usbip-go_lib"],
    env = {"USBIP_GO_TEST_BINARY": "$(location :usbip-go)"},
    rundir = "cmd/usbip-go",
    deps = [
        "//pkg/domain",
        "//pkg/usbip",
        "@com_github_spf13_cobra//:cobra",
        "@com_github_stretchr_testify//require",
    ] + select({
        "@rules_go//go/platform:android": [
            "//internal/testutil",
        ],
        "@rules_go//go/platform:linux": [
            "//internal/testutil",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "go_srcs",
    srcs = glob(["*.go"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "testdata_files",
    srcs = glob(
        ["testdata/**"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
