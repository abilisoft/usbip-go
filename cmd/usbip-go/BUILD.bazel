load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "usbip-go_lib",
    srcs = [
        "activation.go",
        "attach.go",
        "backoff.go",
        "bind.go",
        "completion.go",
        "completion_install.go",
        "detach.go",
        "drain.go",
        "events.go",
        "exitcode.go",
        "factories.go",
        "health.go",
        "history.go",
        "list.go",
        "logger.go",
        "main.go",
        "output.go",
        "port.go",
        "root.go",
        "serve.go",
        "serve_flags.go",
        "status.go",
        "status_exporter.go",
        "status_exporter_concrete.go",
        "style.go",
        "table.go",
        "version.go",
        "watch.go",
    ],
    importpath = "github.com/abilisoft/usbip-go/cmd/usbip-go",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/domain",
        "//pkg/usbip",
        "@com_github_charmbracelet_colorprofile//:colorprofile",
        "@com_github_charmbracelet_fang//:fang",
        "@com_github_coreos_go_systemd_v22//activation",
        "@com_github_lmittmann_tint//:tint",
        "@com_github_spf13_cobra//:cobra",
        "@land_charm_lipgloss_v2//:lipgloss",
        "@land_charm_lipgloss_v2//table",
        "@org_golang_x_sys//unix",
        "@org_golang_x_term//:term",
    ],
)

go_binary(
    name = "usbip-go",
    embed = [":usbip-go_lib"],
    visibility = ["//visibility:public"],
)

go_test(
