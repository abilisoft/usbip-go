        "attach_write_error_test.go",
        "backoff_test.go",
        "binary_missing_parent_dir_test.go",
        "binary_smoke_test.go",
        "completion_test.go",
        "coverage_extra_test.go",
        "detach_render_test.go",
        "drain_test.go",
        "event_no_color_test.go",
        "events_test.go",
        "exitcode_canceled_test.go",
        "exitcode_single_line_test.go",
        "exitcode_test.go",
        "format_module_specific_test.go",
        "gen_golden_test.go",
        "health_test.go",
        "history_test.go",
        "list_test.go",
        "main_ctx_test.go",
        "main_format_error_test.go",
        "main_test.go",
        "no_color_help_test.go",
        "ops_test.go",
        "output_forward_compat_test.go",
        "output_test.go",
        "release_metadata_test.go",
        "root_config_flag_test.go",
        "root_no_color_env_test.go",
        "root_test.go",
        "serve_bind_missing_parent_dir_test.go",
        "serve_bind_timeout_test.go",
        "serve_collision_unlink_test.go",
        "serve_coverage_test.go",
        "serve_drain_timeout_test.go",
