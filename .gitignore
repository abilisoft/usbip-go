# ---------------------------------------------------------------------------
# Build artifacts
# ---------------------------------------------------------------------------
# Produced artifacts consolidate under /build/; bootstrapped tools and Bazel/Go
# working caches stay under the repository-local /.local/ tree.
/build/
/.local/

# Legacy/manual output paths that should not be committed.
/bin/
/dist/
/coverage.out
/coverage.html
*.log
.test-tmp-*/
# go test creates .t-* / TempDir-* sandbox directories under the
# package being tested when t.TempDir / t.MkdirTemp opt out of $TMPDIR.
.t-*/
TempDir-*/

# `go build ./cmd/*` run without `-o` drops binaries at the repo root.
/usbip-go

# Go toolchain scratch files occasionally left behind by failing tests or
# aborted builds.
*.test
*.out
*.prof
*.pprof

# ---------------------------------------------------------------------------
# Local environment managers
# ---------------------------------------------------------------------------
/result
/result-*
.direnv/
.envrc.local

# ---------------------------------------------------------------------------
# Editor / IDE / OS
# ---------------------------------------------------------------------------
# Anchored names catch both real dirs and the character-device shadows the
# sandbox mounts as `.idea` / `.vscode` single entries.
/.idea
/.vscode
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Sandbox $HOME dotfile shadows
# Some sandboxed dev environments bind-mount empty character devices over
# the developer's home dotfiles when the sandbox boots; these are never
# real project content and must not be tracked.
# ---------------------------------------------------------------------------
/.bash_profile
/.bashrc
/.gitconfig
/.gitmodules
/.profile
/.ripgreprc
/.zprofile
/.zshrc

# ---------------------------------------------------------------------------
# Developer tooling local state — never committed
# ---------------------------------------------------------------------------
# Editor / assistant config trees that drop session state, sandbox
# shadows, or per-developer overrides at the repo root. Team-shared
# config, if it ever needs to be versioned, should be added with
# `git add -f` on an explicit path.
.claude/
.codex
.codex/
.cursor/
.aider*
.continue/
.copilot/
.codeium/
.windsurf/
.tabnine/
.ai/
/.mcp.json
# Tool-specific pointer file. Durable repository policy lives in the
# committed root AGENTS.md.
/CLAUDE.md

# Per-tool log/scratch dumps under the system tmp dir.
codex-*.log
/tmp/claude-*
/tmp/codex-*

# ---------------------------------------------------------------------------
# Fixtures captured from a real kernel — regenerated by
# scripts/capture-wire-fixtures.sh. Committed bytes live inline in
# internal/adapter/wire/conformance_test.go.
# ---------------------------------------------------------------------------
/internal/adapter/wire/testdata/real_*.bin
/internal/adapter/wire/testdata/real_capture.*
