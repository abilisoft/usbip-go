# Build artifacts
/bin/
/dist/
/coverage.out
/coverage.html
*.log
.task/

# Sandbox bind-mount shadows of $HOME dotfiles — created by Claude
# Code when the harness sandbox is enabled; never contain project
# content.
/.bash_profile
/.bashrc
/.gitconfig
/.gitmodules
/.idea
/.mcp.json
/.profile
/.ripgreprc
/.vscode
/.zprofile
/.zshrc

# Claude Code local state (project .claude/settings.json + agents/commands/skills ARE committed)
.claude/settings.local.json
.claude/*.local.*
.claude/session*
.claude/cache/
.claude/debug/

# Codex (OpenAI Codex companion / plugin state)
.codex/
codex-*.log
/tmp/codex-*

# Other AI-assistant session state — never commit these
.ai/
.cursor/
.aider*
/tmp/claude-*

# Locally-captured upstream wire fixtures (regenerated by
# scripts/capture-wire-fixtures.sh; real bytes live inline in
# internal/adapter/wire/conformance_test.go).
/internal/adapter/wire/testdata/real_*.bin
/internal/adapter/wire/testdata/real_capture.*
