load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")

filegroup(
    name = "repo_bazel_files",
    srcs = ["BUILD.bazel"] + glob(
        ["*.bzl"],
        allow_empty = True,
        exclude = ["build/**"],
        exclude_directories = 1,
    ),
    visibility = ["//visibility:public"],
)

exports_files([
    "requirements.in",
    "requirements.lock",
])

py_console_script_binary(
    name = "yamllint",
    pkg = "@pip_apps//yamllint",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "testdata_files",
    srcs = glob(
        ["testdata/**"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
